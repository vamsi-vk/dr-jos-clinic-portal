# Database (Neon Postgres or local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth
NEXTAUTH_URL=http://localhost:4200
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Extension JWT (defaults to NEXTAUTH_SECRET if unset)
EXTENSION_JWT_SECRET=replace-with-another-long-random-string

# Seed script defaults
SEED_ADMIN_EMAIL=admin@drjo.clinic
SEED_ADMIN_PASSWORD=ChangeMe123!

# Cloudflare R2 (company logo uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# Optional public base URL if bucket has public access (custom domain or r2.dev)
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
