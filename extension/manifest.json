{
  "manifest_version": 3,
  "name": "Clinic Extension — Dr. Jo's Skin Revive",
  "description": "Custom intake forms, field groups, and clinical panels for your salon workflow",
  "version": "0.1.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://miosalon.com/*",
    "https://*.miosalon.com/*",
    "http://localhost:3000/*",
    "http://localhost:4200/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://miosalon.com/*",
        "https://www.miosalon.com/*",
        "https://*.miosalon.com/*"
      ],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://miosalon.com/*",
        "https://www.miosalon.com/*",
        "https://*.miosalon.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clinic Extension"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
